msgstr "https://github.com/congtoan"

#: media-s3-upload.php:78
msgid "vendor/autoload.php not found. Run \"composer install\" in the plugin folder, or install the release zip that includes vendor/."
msgstr "Không tìm thấy vendor/autoload.php. Chạy \"composer install\" trong thư mục plugin, hoặc cài bản zip release có sẵn thư mục vendor/."

